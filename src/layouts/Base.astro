---
import '../styles/global.css';
import { site } from '../data/site.js';
const { title = site.name, description = site.subtitle } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | {site.name}</title>
</head>
<body>
  <div style="background:#172f62"><header class="container navbar">
    <a href="/" class="brand" aria-label="English in Levels - Início">✦ English<span>inLevels</span></a>
    <nav class="navlinks" aria-label="Menu principal">
      <a href="/">Início</a>
      <a href="/leituras/">Leituras</a>
      <a href="/sobre/">Sobre nós</a>
    </nav>
  </header></div>
  <main><slot /></main>
  <footer class="footer">
    <div class="container footer-inner">
      <span>© {new Date().getFullYear()} English in Levels · Aprender é descobrir novas possibilidades.</span>
      <a href="/sobre/">Nossa missão</a>
    </div>
  </footer>
</body>
</html>